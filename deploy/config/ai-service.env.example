MPRPC_RPC_SERVER_IP=127.0.0.1
MPRPC_RPC_SERVER_PORT=7002
MPRPC_ZOOKEEPER_IP=127.0.0.1
MPRPC_ZOOKEEPER_PORT=2181
MPRPC_ZK_CONNECT_TIMEOUT_MS=2000
MPRPC_ZK_SESSION_TIMEOUT_MS=3000
MPRPC_ZK_REGISTRATION_TIMEOUT_MS=15000
MPRPC_MAX_FRAME_BYTES=4194304
MPRPC_PROVIDER_THREADS=6
MPRPC_PROVIDER_IO_THREADS=2
MPRPC_PROVIDER_QUEUE=64

# Keep this file out of Git after copying it to ai-service.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_HTTP_CONNECT_TIMEOUT_MS=5000
DEEPSEEK_HTTP_TIMEOUT_MS=75000
DEEPSEEK_MAX_RESPONSE_BYTES=524288
DEEPSEEK_CA_BUNDLE=
DEEPSEEK_SYSTEM_PROMPT='You are the NexusIM AI assistant. Give accurate and concise answers.'

# Only permits http://127.0.0.1, localhost, or ::1 for the Stage 5 mock server.
DEEPSEEK_ALLOW_HTTP_MOCK=false
AI_HISTORY_TURNS=10
AI_MAX_CONTEXT_BYTES=65536
AI_MAX_CONVERSATIONS=1000
AI_MAX_PROMPT_BYTES=32768
AI_MAX_CONCURRENT_REQUESTS=4
