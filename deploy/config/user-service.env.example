MPRPC_RPC_SERVER_IP=127.0.0.1
# Optional: endpoint written to ZooKeeper. Required when binding 0.0.0.0 in Docker.
MPRPC_RPC_ADVERTISE_IP=127.0.0.1
MPRPC_RPC_SERVER_PORT=7001
MPRPC_ZOOKEEPER_IP=127.0.0.1
MPRPC_ZOOKEEPER_PORT=2181
MPRPC_ZK_CONNECT_TIMEOUT_MS=2000
MPRPC_ZK_SESSION_TIMEOUT_MS=3000
# Total bounded wait for stale ephemeral method nodes during a fast restart.
MPRPC_ZK_REGISTRATION_TIMEOUT_MS=15000
MPRPC_MAX_FRAME_BYTES=4194304
MPRPC_PROVIDER_THREADS=4
MPRPC_PROVIDER_IO_THREADS=2
MPRPC_PROVIDER_QUEUE=512
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_NAME=nexusim
CHAT_DB_USER=replace-with-runtime-user
CHAT_DB_PASSWORD=replace-with-a-secret
# Test-only fault injection; leave disabled during normal runs.
USER_SERVICE_TEST_DELAY_USER_ID=-1
USER_SERVICE_TEST_DELAY_MS=0
