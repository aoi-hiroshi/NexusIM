# Copy to .env in the repository root before docker compose. Never commit .env.
NEXUSIM_IMAGE_TAG=stage7
# Keep loopback unless a trusted LAN/VMware interface must serve Windows clients.
NEXUSIM_PUBLIC_BIND_IP=127.0.0.1
NEXUSIM_DEBUG_BIND_IP=127.0.0.1

NEXUSIM_DB_ROOT_PASSWORD=replace-with-a-distinct-root-secret
NEXUSIM_DB_NAME=nexusim
NEXUSIM_DB_USER=nexusim_app
NEXUSIM_DB_PASSWORD=replace-with-an-application-secret
NEXUSIM_REDIS_PASSWORD=replace-with-a-redis-secret

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_SYSTEM_PROMPT=You are the NexusIM AI assistant. Give accurate and concise answers.
